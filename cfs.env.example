# Copy to /etc/cfs/cfs.env, chmod 0600, and replace every value.
CFS_ADMIN_EMAIL=admin@example.com
CFS_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_24_CHARACTERS
CFS_DB_PATH=/opt/cloud-file-server/mvc/data/cfs.sqlite
CFS_STORAGE_PATH=/opt/cloud-file-server/storage
CFS_AUDIT_PATH=/var/lib/cfs/audit.jsonl
MAX_UPLOAD_MB=50
MAX_CONCURRENT_UPLOADS=2
